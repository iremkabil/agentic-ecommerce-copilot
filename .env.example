# Copy this file to `.env` and adjust. Never commit your real `.env`.
# All variables are prefixed with COPILOT_ (see src/copilot/config.py).

# --- App ---
COPILOT_ENVIRONMENT=development
COPILOT_LOG_LEVEL=INFO

# --- Database ---
# SQLite by default. For Postgres use e.g.:
# COPILOT_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/copilot
COPILOT_DATABASE_URL=sqlite:///./copilot.db

# --- LLM provider (generic + swappable) ---
# Local + free via Ollama, or any OpenAI-compatible / hosted endpoint.
COPILOT_LLM_PROVIDER=ollama
COPILOT_LLM_MODEL=llama3.1
COPILOT_LLM_BASE_URL=http://localhost:11434/v1
COPILOT_LLM_API_KEY=
COPILOT_LLM_TEMPERATURE=0.0

# --- Retrieval ---
COPILOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Agent ---
COPILOT_MAX_AGENT_STEPS=6
COPILOT_INTENT_CONFIDENCE_THRESHOLD=0.5

# --- Retrieval backend ---
# Use "hashing" for offline dev/CI (no model download); "sentence-transformers"
# for real semantic search.
COPILOT_EMBEDDING_BACKEND=sentence-transformers
COPILOT_EMBEDDING_DIM=256
COPILOT_RETRIEVAL_BACKEND=numpy

# --- Dashboard/client ---
# Where dashboard/chat.py sends POST /chat requests.
COPILOT_API_BASE_URL=http://localhost:8000
